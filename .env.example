# ==============================================================================
# SANATAN DHARMA SUITE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your environment credentials.
# ==============================================================================

# Application Metadata & Runtime
APP_NAME="Sanatan Dharma Suite"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Providers API Keys
OPENAI_API_KEY="sk-proj-your-openai-key"
GEMINI_API_KEY="AIzaSy-your-gemini-key"
DEEPSEEK_API_KEY="sk-your-deepseek-key"
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
ANTHROPIC_API_KEY="sk-ant-api-your-anthropic-key"
GROQ_API_KEY="gsk_your-groq-key"

# Analytics & Webmaster Integrations
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
GOOGLE_SEARCH_CONSOLE="google-site-verification-token"

# SMTP Email Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@sanatantools.org"

# Monetization & Payment Gateways
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
LEMONSQUEEZY_API_KEY="your-lemonsqueezy-api-key"
PAYONEER_KEY="your-payoneer-key"
WISE_KEY="your-wise-key"

# Security & Background Task Secrets
JWT_SECRET="super-secret-jwt-signing-key-change-me"
CRON_SECRET="super-secret-cron-trigger-key-change-me"

# Caching & Error Tracking (Optional)
REDIS_URL="redis://default:password@localhost:6379"
SENTRY_DSN="https://key@o0.ingest.sentry.io/0"
